  "focus": {
    "ring": {
      "$type": "shadow",
      "$value": {
        "color": "{color.brand.red}",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "5px",
        "inset": true
      },
      "$description": "The site's only meaningful shadow: inset 0 0 0 5px #d10000, used natively as the brand's checked/selected indicator. The source site has no global :focus-visible styling at all, so design.css reuses this token as the focus ring — a genuine accessibility addition, not a value taken from an existing focus style."
    }
  }
