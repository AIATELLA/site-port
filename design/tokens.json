    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold": { "$type": "fontWeight", "$value": 700 }
  },
  "typography": {
    "$description": "11-step type scale plus the non-scale link style 7964ex, recorded below for audit completeness (see $extensions.com.aiatella.framer.link). Each step is a composite typography token: family + size + line-height + weight together, exactly as the corresponding utility class in design.css applies them.",
    "display": {
      "xl": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.manrope}",
          "fontSize": "64px",
          "lineHeight": "80px",
          "fontWeight": "{fontWeight.medium}"
        },
        "$extensions": { "com.aiatella.framer": { "preset": "1wnnaf1" } }
      },
      "l": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.manrope}",
          "fontSize": "40px",
          "lineHeight": "48px",
          "fontWeight": "{fontWeight.medium}"
        },
        "$extensions": { "com.aiatella.framer": { "preset": "zgnytv" } }
      }
    },
