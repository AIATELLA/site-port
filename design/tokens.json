    "brand": {
      "red": {
        "DEFAULT": {
          "$type": "color",
          "$value": "#d10000",
          "$description": "Primary brand colour. Passes WCAG AA on white at 5.66:1 — the only brand-red/decorative colour cleared for text use.",
          "$extensions": { "com.aiatella.framer": { "token": "--token-8f13e9a5-235b-419e-8215-8e05e37c6f1d" } }
        },
        "deep": {
          "$type": "color",
          "$value": "#8a0000",
          "$description": "Darker red, used as the gradient partner to color.brand.red.",
