        },
        "strong": {
          "$type": "color",
          "$value": "#ffffff66",
          "$description": "White overlay at 40% alpha. Source CSS writes this as the 4-digit shorthand #fff6, which expands to the same 8-digit value.",
          "$extensions": { "com.aiatella.framer": { "token": "--token-892d3b4a-6d6f-4391-98d2-7d5a5531f4ef" } }
        }
      },
      "subtle": {
        "DEFAULT": {
          "$type": "color",
          "$value": "#f7f7f7",
          "$description": "Off-white background for subtly differentiated sections.",
          "$extensions": { "com.aiatella.framer": { "token": "--token-4bed56f7-5616-4940-9459-b20c606028a2" } }
        },
        "muted": {
          "$type": "color",
          "$value": "#f7f7f7b3",
          "$description": "surface.subtle at 70% alpha.",
          "$extensions": { "com.aiatella.framer": { "token": "--token-75be653a-a30f-4bed-b7a1-6f15eda83e45" } }
        },
        "overlay": {
          "$type": "color",
          "$value": "#f7f7f766",
          "$description": "surface.subtle at 40% alpha.",
          "$extensions": { "com.aiatella.framer": { "token": "--token-4f6ed643-c2d1-434c-9281-e4f9e79f4a80" } }
        }
      }
    },
    "border": {
      "DEFAULT": {
        "$type": "color",
        "$value": "#dbdbdb",
        "$description": "Default hairline border colour.",
        "$extensions": { "com.aiatella.framer": { "token": "--token-d55a03e9-3ce2-47ff-a778-54e0d6ff1911" } }
