  "space": {
    "$description": "4px-based scale covering every spacing value observed in the source CSS, so Phase B token migration is a pure rename. Two off-scale outliers (10px, 104px) are kept under space.legacy.* rather than rounded.",
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" },
    "32": { "$type": "dimension", "$value": "128px" },
    "legacy": {
      "10": {
        "$type": "dimension",
        "$value": "10px",
        "$description": "Off-scale outlier. Not on the 4px grid (would need to be 2.5 units). Flagged for reconciliation in a later phase, not silently rounded."
      },
      "26": {
        "$type": "dimension",
        "$value": "104px",
        "$description": "Off-scale outlier (104px = 26 × 4px, between space.20=80px and space.32=128px). Flagged for reconciliation in a later phase, not silently rounded."
      }
    }
  },
  "radius": {
    "m": { "$type": "dimension", "$value": "20px", "$description": "Dominant radius, 20 uses in the source CSS." },
    "l": { "$type": "dimension", "$value": "40px" },
    "pill": { "$type": "dimension", "$value": "100px" }
  },
  "breakpoint": {
    "$description": "Framer emits three layout variants (desktop/tablet/mobile). Boundaries are inconsistent in the source: company.css uses 810px for its tablet breakpoint where every other page CSS uses 860px. This token set normalises on 860px; company.css's 810px outlier is deferred to Phase C, which must pixel-verify company.html in the 810–860px window.",
    "tablet": { "$type": "dimension", "$value": "860px" },
    "desktop": { "$type": "dimension", "$value": "1200px" }
  },
  "motion": {
    "easing": {
      "standard": {
        "$type": "cubicBezier",
