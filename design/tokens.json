{
  "$description": "AIATELLA design tokens. W3C DTCG format. Source of truth for design/design.css and design/tokens.ts, both generated by design/build-tokens.py. Never hand-edit design.css or tokens.ts. Every colour and type-scale value here was measured from assets/css/*.css in the site-port Framer export; see docs/superpowers/specs/2026-07-30-aiatella-design-system-design.md sections 3-4 for provenance and design/AIATELLA-DESIGN-SYSTEM.md for the human-readable guide.",
  "color": {
    "$description": "16 semantic colours collapsed from 17 Framer UUID tokens (one duplicate #fff pair). Each leaf records its originating --token-<uuid> in $extensions.com.aiatella.framer.",
    "ink": {
      "DEFAULT": {
        "$type": "color",
        "$value": "#000000",
        "$description": "Primary text colour.",
        "$extensions": { "com.aiatella.framer": { "token": "--token-6fa10ce0-ad77-4ae2-9539-cc850356aaa1" } }
      },
      "muted": {
        "$type": "color",
        "$value": "#000000b3",
        "$description": "Ink at 70% alpha, for secondary text.",
        "$extensions": { "com.aiatella.framer": { "token": "--token-e27e3a45-73c6-4710-bb04-0591af8c2e3e" } }
      },
      "overlay": {
        "$type": "color",
        "$value": "#0000000d",
        "$description": "Ink at 5% alpha, for hairline dividers and subtle scrims on light surfaces.",
        "$extensions": { "com.aiatella.framer": { "token": "--token-412cf3f5-6bcc-4fb2-92b9-1f48634eb54c" } }
      },
      "warm": {
        "$type": "color",
        "$value": "#1c1313",
        "$description": "Warm near-black used as text colour on several heading/body presets instead of pure black.",
        "$extensions": { "com.aiatella.framer": { "token": "--token-137326a3-3c3e-44ef-8c1f-a21abf93e3eb" } }
      }
    },
    "surface": {
      "DEFAULT": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Primary background colour. Collapses two identical Framer UUID tokens that both resolved to #fff.",
        "$extensions": { "com.aiatella.framer": { "tokens": [
          "--token-55a9b33d-0e60-4abe-a1c9-c52a1cf57bd9",
          "--token-6c9f0706-c7df-4374-b4b0-8bf4d4d75293"
        ] } }
      },
      "muted": {
        "$type": "color",
        "$value": "#ffffffb3",
        "$description": "Surface at 70% alpha.",
        "$extensions": { "com.aiatella.framer": { "token": "--token-90b2aadb-7742-472b-8ea3-e5a41ff901d4" } }
      },
      "overlay": {
        "DEFAULT": {
          "$type": "color",
          "$value": "#ffffff1a",
